# Copy these values into Vercel Project Settings > Environment Variables.
# Never commit a real .env file.

# --- Database (Vercel Marketplace / Neon) -----------------------------------
# Runtime: pooled connection string. Add ?pgbouncer=true if the provider URL
# does not already include it. Used by the Next.js app in Vercel Functions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/DATABASE?sslmode=require&pgbouncer=true"

# Migrations and one-time SQLite transfer: direct (non-pooler) connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# --- Application -------------------------------------------------------------
# Long random value. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Public Vercel origin. Must NOT contain localhost in production.
# Example: https://wishstock.vercel.app
APP_URL="https://your-wishstock-domain.vercel.app"

# Use "demo" for the labelled test mode (allowed in production, no real charge).
# Use "stripe" only with a verified merchant account and webhook secret.
PAYMENT_PROVIDER="stripe"

# Only used for locally signed demo webhooks (development/preview only).
PAYMENT_DEMO_WEBHOOK_SECRET="replace-with-a-long-random-demo-secret"

# Stripe (required when PAYMENT_PROVIDER=stripe).
STRIPE_SECRET_KEY="sk_live_or_sk_test..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional. Only needed for external credentialed API clients; the UI is same-origin.
# CLIENT_ORIGIN="https://your-wishstock-domain.vercel.app"

# Optional escape hatch. Cookies are already Secure when NODE_ENV=production.
# COOKIE_SECURE="true"

# --- Local SQLite -> PostgreSQL transfer only --------------------------------
# Optional override for npm run db:transfer (defaults to prisma/dev.db).
# SQLITE_PATH="./prisma/dev.db"

# Not required:
# - Vercel Blob: the app stores no uploaded files.
# - CRON_SECRET/Vercel Cron: expiry is calculated from expiresAt; no scheduler runs.
